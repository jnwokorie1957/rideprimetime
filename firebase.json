{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/author/primetime{,/**}",
        "destination": "/non-emergency-medical-transportation-what-we-stand-for/",
        "type": 301
      },
      {
        "source": "/non-emergency-medical-transportation-service-areas-covered/pearland",
        "destination": "/non-emergency-medical-transportation-service-areas-covered/",
        "type": 302
      },
      {
        "source": "/non-emergency-medical-transportation-service-areas-covered/pearland/",
        "destination": "/non-emergency-medical-transportation-service-areas-covered/",
        "type": 302
      },
      {
        "source": "/non-emergency-medical-transportation-service-areas-covered/sugar-land",
        "destination": "/non-emergency-medical-transportation-service-areas-covered/",
        "type": 302
      },
      {
        "source": "/non-emergency-medical-transportation-service-areas-covered/sugar-land/",
        "destination": "/non-emergency-medical-transportation-service-areas-covered/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ]
  }
}
